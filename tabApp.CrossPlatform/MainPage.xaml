<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tabApp.CrossPlatform.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16">

            <Label
                Text="Background Location POC"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                x:Name="StatusLabel"
                Text="Status: idle" />

            <Label
                x:Name="LastUpdateLabel"
                Text="Last update: (none)" />

            <Label
                x:Name="LastErrorLabel"
                Text="Last error: (none)" />

            <Button
                Text="Request Permissions"
                Clicked="OnRequestPermissionsClicked" />

            <Button
                Text="Start Tracking"
                Clicked="OnStartTrackingClicked" />

            <Button
                Text="Stop Tracking"
                Clicked="OnStopTrackingClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
